# Copie para apps/mobile/.env (não versionado). Para builds no EAS, cadastre as mesmas variáveis com
# `npx eas-cli env:create` (o .env não é enviado). Passo a passo em docs/LOGIN_SOCIAL.md.

# Supabase (painel → Project Settings → API Keys). Só a chave PUBLICÁVEL (sb_publishable_...), nunca a secreta.
EXPO_PUBLIC_SUPABASE_URL=https://snuxiwwvlaryggezcezi.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In (Google Cloud → APIs e serviços → Credenciais). Deixe vazio enquanto não houver credenciais.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps SDK for Android (obrigatória no development build e em produção; o Expo Go não precisa).
GOOGLE_MAPS_ANDROID_API_KEY=
