{
  "name": "grad-monorepo",
  "private": true,
  "description": "Grad — mapa de segurança de São Paulo (app Expo + Supabase + scripts de dados)",
  "scripts": {
    "install:all": "npm --prefix apps/mobile ci && npm --prefix scripts ci",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "typecheck": "npm --prefix apps/mobile exec -- tsc --noEmit -p apps/mobile && npm --prefix scripts run typecheck",
    "data:import-geo": "npm --prefix scripts run import:geo --",
    "data:import-crimes": "npm --prefix scripts run import:crimes --",
    "mobile:go": "npm --prefix apps/mobile run go",
    "data:import-postos": "npm --prefix scripts run import:postos --",
    "data:verificar": "npm --prefix scripts run verificar --",
    "data:gravar": "npm --prefix scripts run gravar --",
    "data:conferir-banco": "npm --prefix scripts run conferir-banco",
    "data:diagnostico": "npm --prefix scripts run diagnostico --",
    "test": "npm --prefix scripts test",
    "data:limpar": "npm --prefix scripts run limpar --",
    "data:processar": "npm --prefix scripts run processar --",
    "data:consolidar": "npm --prefix scripts run consolidar --",
    "data:comparar-banco": "npm --prefix scripts run comparar-banco --",
    "data:indice-cnefe": "npm --prefix scripts run indice-cnefe --",
    "data:geocodificar": "npm --prefix scripts run geocodificar --",
    "data:comparar-geocodificacao": "npm --prefix scripts run comparar-geocodificacao --"
  }
}
